<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentModbus" Version="5.3.2" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.21.0" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua" Version="1.5.375.457" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Config\BatchPlantServer.Config.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Exclude old v1 source files (kept for reference, will be removed after v2 is stable) -->
  <ItemGroup>
    <Compile Remove="BatchPlantNodeManager.cs" />
    <Compile Remove="BatchPlantServer.cs" />
    <Compile Remove="BatchPlantServerConfiguration.cs" />
    <Compile Remove="Namespaces.cs" />
    <Compile Remove="Helpers\**" />
    <Compile Remove="Initialization\**" />
    <Compile Remove="Operations\**" />
    <Compile Remove="Simulation\**" />
    <Compile Remove="Alarms\**" />
  </ItemGroup>

</Project>
